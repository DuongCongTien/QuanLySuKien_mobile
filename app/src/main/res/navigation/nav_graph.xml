    <!-- 30. Waitlist Join & Status -->
    <fragment
        android:id="@+id/waitlistJoinFragment"
        android:name="com.group29.eventapp.presentation.waitlist.WaitlistJoinFragment"
        android:label="WaitlistJoin"
        tools:layout="@layout/fragment_waitlist_join" />

    <!-- 31. Seat Offer -->
    <fragment
        android:id="@+id/seatOfferFragment"
        android:name="com.group29.eventapp.presentation.waitlist.SeatOfferFragment"
        android:label="SeatOffer"
        tools:layout="@layout/fragment_seat_offer" />

    <!-- 32. Organizer Waitlist Management -->
    <fragment
        android:id="@+id/organizerWaitlistFragment"
        android:name="com.group29.eventapp.presentation.waitlist.OrganizerWaitlistFragment"
        android:label="OrganizerWaitlist"
        tools:layout="@layout/fragment_organizer_waitlist" />

</navigation>
