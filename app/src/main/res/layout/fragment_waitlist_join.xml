<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/title_waitlist_status"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- FIFO Rule Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quy chế danh sách chờ thông minh (FIFO)"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/color_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/waitlist_fifo_notice"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/color_on_surface" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbAgreeFifo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:checked="true"
                        android:text="@string/waitlist_fifo_agree" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Queue Position Card (When in queue) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQueueStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/waitlist_joined_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/color_on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQueuePosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceHeadlineLarge"
                        android:textColor="@color/color_primary"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        tools:text="#1" />

                    <TextView
                        android:id="@+id/tvJoinedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_surface_variant"
                        tools:text="Thời gian gia nhập: 16/11/2026 23:15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLeaveWaitlist"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:minHeight="48dp"
                        android:text="@string/btn_leave_waitlist"
                        android:textColor="@color/status_error"
                        app:strokeColor="@color/status_error" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Offer Alert Card (When offer is received) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOfferAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_warning_container"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bạn có một lời mời nhận chỗ!"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/color_on_warning_container"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đã có ghế trống được giải phóng. Bấm để xem chi tiết và xác nhận nhận vé."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_warning_container" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewOffer"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="Xem lời mời nhận chỗ" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
