<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="@dimen/spacing_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TextAppearance.EventApp.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bộ lọc tìm kiếm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFilter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_reset"
                android:textColor="@color/status_error"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:background="@color/divider" />

        <!-- 1. Danh mục -->
        <TextView
            style="@style/TextAppearance.EventApp.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Chủ đề / Danh mục" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAllCat"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterTech"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Công nghệ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trí tuệ nhân tạo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterCloud"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điện toán đám mây" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterSystem"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thiết kế hệ thống" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterCareer"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỹ năng nghề nghiệp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 2. Hình thức tham gia -->
        <TextView
            style="@style/TextAppearance.EventApp.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Hình thức tổ chức" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả hình thức" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineOffline"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trực tiếp tại Đà Nẵng" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineTrue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trực tuyến (Online)" />

        </com.google.android.material.chip.ChipGroup>

        <!-- 3. Trạng thái sự kiện -->
        <TextView
            style="@style/TextAppearance.EventApp.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="Trạng thái sự kiện" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilterStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả trạng thái" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusPublished"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp diễn ra" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusOngoing"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang diễn ra" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatusCompleted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã kết thúc" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Apply Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            style="@style/Widget.EventApp.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/spacing_16"
            android:text="@string/btn_apply" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
