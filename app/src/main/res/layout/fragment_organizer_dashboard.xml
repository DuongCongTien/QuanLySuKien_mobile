<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/title_org_dashboard"
        app:titleTextAppearance="@style/TextAppearance.EventApp.Title" />

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16"
            android:paddingBottom="80dp">

            <!-- Stats 2x2 Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Total Registered -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <TextView
                            style="@style/TextAppearance.EventApp.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TỔNG ĐĂNG KÝ"
                            android:textColor="@color/on_surface_hint" />

                        <TextView
                            android:id="@+id/tvTotalRegistered"
                            style="@style/TextAppearance.EventApp.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:text="675"
                            android:textColor="@color/primary" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Checked-in -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <TextView
                            style="@style/TextAppearance.EventApp.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐÃ CHECK-IN"
                            android:textColor="@color/on_surface_hint" />

                        <TextView
                            android:id="@+id/tvTotalCheckedIn"
                            style="@style/TextAppearance.EventApp.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:text="488"
                            android:textColor="@color/status_success" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <!-- 3. Pending Check-in -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <TextView
                            style="@style/TextAppearance.EventApp.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHƯA ĐẾN"
                            android:textColor="@color/on_surface_hint" />

                        <TextView
                            android:id="@+id/tvTotalPending"
                            style="@style/TextAppearance.EventApp.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:text="187"
                            android:textColor="@color/status_warning" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Cancelled -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EventApp.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <TextView
                            style="@style/TextAppearance.EventApp.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐÃ HỦY VÉ"
                            android:textColor="@color/on_surface_hint" />

                        <TextView
                            android:id="@+id/tvTotalCancelled"
                            style="@style/TextAppearance.EventApp.HeadlineLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:text="35"
                            android:textColor="@color/status_error" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Attendance Rate Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventApp.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.EventApp.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tỷ lệ tham dự sự kiện (Attendance Rate)" />

                        <TextView
                            android:id="@+id/tvAttendanceRatePercent"
                            style="@style/TextAppearance.EventApp.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72.3%"
                            android:textColor="@color/status_success" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBarAttendanceRate"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:max="100"
                        android:progress="72"
                        android:progressTint="@color/status_success" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Managed Events Section -->
            <TextView
                style="@style/TextAppearance.EventApp.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="Sự kiện đang quản lý" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrgEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FAB: Create New Event -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateEvent"
        style="@style/Widget.Material3.ExtendedFloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_24"
        android:text="Tạo sự kiện mới"
        app:icon="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading & Error -->
    <include
        android:id="@+id/includeLoading"
        layout="@layout/layout_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <include
        android:id="@+id/includeError"
        layout="@layout/layout_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
