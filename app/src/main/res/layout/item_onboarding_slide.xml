<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/spacing_32">

    <ImageView
        android:id="@+id/ivSlideIllustration"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:contentDescription="Minh họa giới thiệu"
        android:src="@drawable/ic_onboarding_1"
        app:layout_constraintBottom_toTopOf="@+id/tvSlideTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSlideTitle"
        style="@style/TextAppearance.EventApp.HeadlineLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_32"
        android:gravity="center"
        android:text="@string/onboarding_title_1"
        android:textColor="@color/primary"
        app:layout_constraintBottom_toTopOf="@+id/tvSlideDesc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivSlideIllustration" />

    <TextView
        android:id="@+id/tvSlideDesc"
        style="@style/TextAppearance.EventApp.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/onboarding_desc_1"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSlideTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
