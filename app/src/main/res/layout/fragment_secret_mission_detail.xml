<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/title_mission_detail"
            app:titleCentered="true"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Mission Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMissionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/color_on_surface"
                            android:textStyle="bold"
                            tools:text="Truy tìm thông điệp AI bí mật" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipReward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:minHeight="32dp"
                            android:textColor="@color/color_primary"
                            android:textSize="12sp"
                            app:chipCornerRadius="12dp"
                            tools:text="+150 EXP" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/color_primary"
                        android:textStyle="bold"
                        tools:text="Thời gian còn lại: 01:25:40" />

                    <TextView
                        android:id="@+id/tvMissionDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/color_on_surface_variant"
                        tools:text="Tại một góc trưng bày triển lãm AI có ẩn chứa mã QR bí mật..." />

                    <TextView
                        android:id="@+id/tvBadgeReward"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_secondary"
                        android:textStyle="bold"
                        tools:text="Phần thưởng huy hiệu: Thám tử AI" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progressive Hints Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Gợi ý manh mối theo cấp độ:"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/color_on_surface"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUnlockHint"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_unlock_hint"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Hint Level 1 -->
                    <TextView
                        android:id="@+id/tvHintLevel1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_bottom_sheet"
                        android:padding="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_surface"
                        tools:text="Gợi ý 1: Khu vực gian hàng triển lãm công nghệ tại Tầng 1." />

                    <!-- Hint Level 2 -->
                    <TextView
                        android:id="@+id/tvHintLevel2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_bottom_sheet"
                        android:padding="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_surface"
                        tools:text="Gợi ý 2: Gần bàn trưng bày robot AI thông minh." />

                    <!-- Hint Level 3 -->
                    <TextView
                        android:id="@+id/tvHintLevel3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_bottom_sheet"
                        android:padding="8dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_surface"
                        tools:text="Gợi ý 3 (Chính xác): Quét mã QR được dán dưới chân poster robot NPU." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Evidence Submission Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gửi bằng chứng hoàn thành:"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/color_on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMockScanQr"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Quét QR ẩn"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMockUploadPhoto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="Chụp ảnh minh chứng"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEvidence"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEvidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/mission_evidence_hint"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitEvidence"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="50dp"
                        android:text="@string/btn_submit_evidence" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Single-claim Reward Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="2dp"
                app:strokeColor="@color/color_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_medium">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phần thưởng nhiệm vụ (Nhận một lần):"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/color_on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClaimStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/color_on_surface_variant"
                        tools:text="Chỉ có thể nhận thưởng khi Ban tổ chức đã duyệt bằng chứng." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClaimReward"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="50dp"
                        android:text="@string/btn_claim_reward" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
